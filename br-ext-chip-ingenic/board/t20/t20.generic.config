# ==========================================
# USB STORAGE SUPPORT
# ==========================================
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_COMMON=y
CONFIG_USB_JZ_DWC2=y
CONFIG_USB_DWC2_HOST_ONLY=y
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y

# ==========================================
# SENSOR JXF23
# ==========================================
CONFIG_VIDEO_JXF23=y

# ==========================================
# DISABLE UNUSED SENSORS (Экономия памяти)
# ==========================================
# CONFIG_VIDEO_JXF22 is not set
# CONFIG_VIDEO_GC2053 is not set
# CONFIG_VIDEO_SC2135 is not set
# CONFIG_VIDEO_SC2232 is not set
# CONFIG_VIDEO_SC2235 is not set
# CONFIG_VIDEO_SC2335 is not set
# CONFIG_VIDEO_OV2735 is not set
# CONFIG_VIDEO_OV4689 is not set
# CONFIG_VIDEO_OV9750 is not set

# ==========================================
# DISABLE MOTION DETECTION (Чтобы не вешало камеру)
# ==========================================
# CONFIG_ISP_MOTION_DETECT is not set